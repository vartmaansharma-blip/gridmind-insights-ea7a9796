# Use an isolated development project. Replace every placeholder locally.
# Client variables are public: never use a service-role or secret key here.
SUPABASE_PROJECT_ID="your-development-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-development-publishable-key"
SUPABASE_URL="https://your-development-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-development-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-development-publishable-key"
VITE_SUPABASE_URL="https://your-development-project-ref.supabase.co"

# Optional server-backed synthetic case testing; disabled by default.
# Apply the source migration only to an isolated development database first.
GRIDMIND_CONNECTED_CASES_ENABLED="disabled"
# Server-only secret: NEVER prefix with VITE_, never put in browser settings.
GRIDMIND_CASES_SERVICE_ROLE_KEY="your-isolated-development-service-role-key"
