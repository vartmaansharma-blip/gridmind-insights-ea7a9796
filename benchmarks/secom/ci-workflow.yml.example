name: GridMind SECOM Benchmark

on:
  pull_request:
    branches: [main]
    paths:
      - "benchmarks/secom/**"
      - ".github/workflows/secom-benchmark.yml"
  push:
    branches: [main]
    paths:
      - "benchmarks/secom/**"
      - ".github/workflows/secom-benchmark.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: secom-benchmark-${{ github.ref }}
  cancel-in-progress: true

jobs:
  offline-benchmark:
    name: Pinned SECOM data, leakage contracts, and held-out reproduction
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      OPENBLAS_NUM_THREADS: "1"
      OMP_NUM_THREADS: "1"
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: "3.12.14"
      - name: Install benchmark-only pinned dependencies
        run: python -m pip install -r benchmarks/secom/requirements.txt
      - name: Run no-network parser, leakage and metric contracts
        run: python -m unittest discover -s benchmarks/secom -p 'test_*.py' -v
      - name: Explicitly acquire checksum-pinned public UCI archive (1.9 MB)
        run: python benchmarks/secom/fetch.py
      - name: Reproduce full real-data benchmark offline and independently reconcile confusion counts
        env:
          SECOM_REAL_ACCEPTANCE: "1"
        run: python -m unittest discover -s benchmarks/secom -p 'test_*.py' -v
