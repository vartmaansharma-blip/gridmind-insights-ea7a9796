  "schema_version": "gridmind-industry-machine-taxonomy-v1",
  "purpose": "Industry-to-machine ontology for GridMind. Industry membership describes typical equipment; it does not assert that a specific factory owns every listed machine.",
  "design_principles": [
    "Separate industry taxonomy from machine knowledge.",
    "A machine can belong to many industries.",
    "Distinguish core production machines from shared utilities and infrastructure.",
    "Use industry context to select likely machines, then verify actual installed assets.",
    "Do not enable diagnostics merely because an industry-machine relationship exists."
