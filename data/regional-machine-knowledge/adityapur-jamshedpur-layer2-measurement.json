{
  "schema_version": "1.0.0",
  "layer": "L2",
  "title": "Adityapur-Jamshedpur Machine Knowledge — Measurement Layer",
  "principles": [
    "Prefer trusted controller, PLC, drive or industrial-protocol data before retrofit sensing.",
    "Select measurements from the engineering question; never install a fixed sensor bundle by default.",
    "Every measurement carries source identity, unit, timestamp, quality status and operating context.",
    "Do not invent accuracy, calibration intervals or health thresholds.",
    "Diagnostics remain blocked until the machine-specific evidence gate is satisfied."
  ],
